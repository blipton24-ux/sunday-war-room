# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
#
# docker compose reads this file automatically (the values below are also its defaults), so
# `docker compose up --build` works with no .env at all. A real deployment sets these in the
# hosting platform's environment instead. The web server refuses the development secrets
# below when BETTER_AUTH_URL is not a local address.

# --- docker compose: database, redis and published ports ---
POSTGRES_USER=swr
POSTGRES_PASSWORD=swr
POSTGRES_DB=swr
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# --- api + worker ---
# These two are for running the API natively (outside Docker); compose sets its own.
# Inside compose the hosts are "db" and "redis"; from your machine they are localhost.
DATABASE_URL=postgresql+asyncpg://swr:swr@localhost:5432/swr
TEST_DATABASE_URL=postgresql+asyncpg://swr:swr@localhost:5432/swr_test
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development
# Shared secret used by Next.js to sign the API token and by FastAPI to verify it (ADR-036).
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Browsers never call the API directly (ADR-036), so this can stay as-is.
CORS_ORIGINS=http://localhost:3000

# --- web (Next.js); for native development copy these into web/.env.local ---
# The address you open in the browser. Sign-in cookies and links depend on it, so when you
# change WEB_PORT, change this to match.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Better Auth's database connection (plain postgres:// URL; same database as the API).
# Native development only: compose builds this from the POSTGRES_* values above.
AUTH_DATABASE_URL=postgres://swr:swr@localhost:5432/swr
# Where the Next.js server reaches FastAPI (native development; compose uses http://api:8000).
API_INTERNAL_URL=http://localhost:8000
# Google sign-in (optional locally): create an OAuth client in Google Cloud Console with
# redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email via Resend (ADR-029). Empty on this machine: the sign-in link is printed in
# the web server's log instead (only when BETTER_AUTH_URL is a local address).
RESEND_API_KEY=
# Sign-in link requests allowed per minute from one address (default 5).
# MAGIC_LINK_RATE_LIMIT_MAX=5
EMAIL_FROM=Sunday War Room <signin@your-domain.com>
