# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=swr
POSTGRES_PASSWORD=swr
POSTGRES_DB=swr
DB_PORT=5432
REDIS_PORT=6379

# --- api + worker ---
# Inside compose the host is "db"/"redis"; from your machine it is localhost.
DATABASE_URL=postgresql+asyncpg://swr:swr@localhost:5432/swr
TEST_DATABASE_URL=postgresql+asyncpg://swr:swr@localhost:5432/swr_test
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development
# Shared secret used by Next.js to sign the API token and by FastAPI to verify it (ADR-017).
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
