# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=swr
POSTGRES_PASSWORD=swr
POSTGRES_DB=swr
DB_PORT=5432
REDIS_PORT=6379

# --- api + worker ---
# Inside compose the host is "db"/"redis"; from your machine it is localhost.
DATABASE_URL=postgresql+asyncpg://swr:swr@localhost:5432/swr
TEST_DATABASE_URL=postgresql+asyncpg://swr:swr@localhost:5432/swr_test
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development
# Shared secret used by Next.js to sign the API token and by FastAPI to verify it (ADR-017).
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Browsers never call the API directly (ADR-036), so this can stay as-is.
CORS_ORIGINS=http://localhost:3000

# --- web (Next.js): copy these into web/.env.local ---
# Public URL of the web app.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Better Auth's database connection (plain postgres:// URL; same database as the API).
AUTH_DATABASE_URL=postgres://swr:swr@localhost:5432/swr
# Where the Next.js server reaches FastAPI. Must use the SAME API_JWT_SECRET as the API.
API_INTERNAL_URL=http://localhost:8000
# Google sign-in (optional locally): create an OAuth client in Google Cloud Console with
# redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email via Resend (ADR-029). Empty in development: the link is printed in the
# web server's terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Sunday War Room <signin@your-domain.com>
